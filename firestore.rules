rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isValidRoom(data) {
      return data.size() == 8 &&
             data.title is string &&
             data.title.size() >= 5 &&
             data.title.size() <= 100 &&
             data.location is string &&
             data.location.size() > 0 &&
             data.price is string &&
             int(data.price) >= 0 &&
             int(data.price) <= 1000000 &&
             data.phone is string &&
             data.phone.size() >= 10 &&
             data.imageUrl is string &&
             data.userId is string &&
             data.featured is bool &&
             data.createdAt is number;
    }
    
    function isValidUpdate(data) {
      return (data.title is string && data.title.size() >= 5 && data.title.size() <= 100) ||
             (data.location is string && data.location.size() > 0) ||
             (data.price is string && int(data.price) >= 0 && int(data.price) <= 1000000);
    }
    
    // Rooms collection
    match /rooms/{document=**} {
      // Anyone can read
      allow read: if true;
      
      // Only authenticated users can create
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidRoom(request.resource.data);
      
      // Only owner can update (limited fields)
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       isValidUpdate(request.resource.data);
      
      // Only owner can delete
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
    
    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Users can create/update their own profile
      allow create, update: if isAuthenticated() &&
                              isOwner(userId) &&
                              request.resource.data.userId == userId &&
                              request.resource.data.email is string;
    }
    
    // Reviews collection
    match /rooms/{roomId}/reviews/{document=**} {
      // Anyone can read reviews
      allow read: if true;
      
      // Authenticated users can create reviews
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.rating >= 1 &&
                       request.resource.data.rating <= 5 &&
                       request.resource.data.comment is string;
      
      // Only review author can update/delete
      allow update, delete: if isAuthenticated() &&
                              resource.data.userId == request.auth.uid;
    }
  }
}
