rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.uid in get(/databases/$(database)/documents/admins/list).data.uids;
    }

    function validRoom(room) {
      return room.size() == 8 &&
             room.title is string && room.title.size() >= 5 && room.title.size() <= 100 &&
             room.location is string && room.location.size() >= 2 && room.location.size() <= 50 &&
             room.price is number && room.price > 0 && room.price <= 100000 &&
             room.phone is string && room.phone.matches('^\\+?[0-9\\s\\-\\(\\)]{7,}$') &&
             room.imageUrl is string &&
             room.userId is string &&
             room.featured is bool &&
             room.createdAt is number;
    }

    // Rooms collection
    match /rooms/{roomId} {
      // Read: Anyone authenticated can read
      allow read: if isAuthenticated();

      // Create: Authenticated users can create their own rooms
      allow create: if isAuthenticated() && 
                      validRoom(request.resource.data) &&
                      isOwner(request.resource.data.userId);

      // Update: Only owner can update, or admin
      allow update: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || isAdmin()) &&
                      validRoom(request.resource.data);

      // Delete: Only owner or admin can delete
      allow delete: if isAuthenticated() && 
                      (isOwner(resource.data.userId) || isAdmin());
    }

    // Admin collection
    match /admins/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Managed via Cloud Functions
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Activity logs (admin only)
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // System only
    }
  }
}
